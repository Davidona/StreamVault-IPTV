    <string name="setup_epg_sync_mode_label">EPG-synkronisering</string>
    <string name="setup_epg_sync_mode_helper">Forudindlæsning bevarer den nuværende adfærd. Baggrund afslutter opsætningen først, og Spring over lader guideopdatering vente til senere.</string>
    <string name="setup_epg_sync_mode_upfront_title">Fuld EPG nu</string>
    <string name="setup_epg_sync_mode_upfront_description">Download udbyder- og eksterne guide-data under opsætningen, før den afsluttes.</string>
    <string name="setup_epg_sync_mode_background_title">Indlæs EPG i baggrunden</string>
    <string name="setup_epg_sync_mode_background_description">Afslut opsætningen først, og hent derefter guide-data automatisk i baggrunden.</string>
    <string name="setup_epg_sync_mode_skip_title">Spring EPG over nu</string>
    <string name="setup_epg_sync_mode_skip_description">Hent ikke guide-data automatisk. Du kan opdatere EPG senere fra Indstillinger.</string>
    <string name="setup_stalker_epg_sync_mode_helper">Stalker kan bruge portalens indbyggede guide, når XMLTV mangler eller ikke er tilgængelig. Hent nu importerer den under opsætningen, baggrund udsætter det, og spring over lader guiden blive indlæst efter behov.</string>
    <string name="setup_stalker_epg_sync_mode_upfront_description">Hent livekanaler og importer Stalker-portalens guide under opsætningen. Hvis XMLTV er konfigureret og virker, bruges det først.</string>
    <string name="setup_stalker_epg_sync_mode_background_description">Afslut opsætningen først, og importer derefter Stalker-portalens guide i baggrunden. Hvis XMLTV er konfigureret og virker, bruges det først.</string>
    <string name="setup_stalker_epg_sync_mode_skip_description">Importér ikke guide-data i bulk automatisk. Live-guide-data kan stadig indlæses efter behov, mens du gennemser kanaler.</string>
