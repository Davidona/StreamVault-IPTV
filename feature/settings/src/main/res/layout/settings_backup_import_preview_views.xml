<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/previewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_backup_preview_dialog_background"
    android:padding="@dimen/settings_backup_preview_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/previewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_backup_preview_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/previewSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_backup_preview_header_spacing"
            android:textColor="@color/settings_backup_preview_text_secondary"
            android:textSize="14sp" />

        <ScrollView
            android:id="@+id/previewScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/settings_backup_preview_section_spacing"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:id="@+id/previewBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="12dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/preferencesTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/preferencesConflict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/preferencesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/providersTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/providersConflict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/providersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/savedTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/savedConflict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/savedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/historyTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/historyConflict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/historyCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/multiViewTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/multiViewConflict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/multiViewCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/recordingsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_primary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/recordingsConflict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/settings_backup_preview_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/recordingsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/conflictStrategyLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_backup_preview_brand"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/strategyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/keepExistingButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/settings_backup_preview_control_background"
                        android:buttonTint="@color/settings_backup_preview_brand"
                        android:focusable="true"
                        android:paddingStart="@dimen/settings_backup_preview_control_padding_horizontal"
                        android:paddingEnd="@dimen/settings_backup_preview_control_padding_horizontal"
                        android:paddingTop="@dimen/settings_backup_preview_control_padding_vertical"
                        android:paddingBottom="@dimen/settings_backup_preview_control_padding_vertical"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                    <RadioButton
                        android:id="@+id/replaceExistingButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/settings_backup_preview_control_background"
                        android:buttonTint="@color/settings_backup_preview_brand"
                        android:focusable="true"
                        android:paddingStart="@dimen/settings_backup_preview_control_padding_horizontal"
                        android:paddingEnd="@dimen/settings_backup_preview_control_padding_horizontal"
                        android:paddingTop="@dimen/settings_backup_preview_control_padding_vertical"
                        android:paddingBottom="@dimen/settings_backup_preview_control_padding_vertical"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/importSectionsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_backup_preview_brand"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/preferencesSwitchLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/importPreferencesSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_backup_section_preferences" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/providersSwitchLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/importProvidersSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_backup_section_providers" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/savedSwitchLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/importSavedSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_backup_section_saved" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/historySwitchLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/importHistorySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_backup_section_history" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/multiViewSwitchLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/importMultiViewSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_backup_section_multiview" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/recordingsSwitchLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/settings_backup_preview_text_primary"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/importRecordingsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_backup_section_recordings" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scrollHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/settings_backup_preview_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_backup_preview_footer_spacing"
            android:gravity="end"
            android:orientation="horizontal">
            <Button
                android:id="@+id/cancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_backup_preview_control_background"
                android:textColor="@color/settings_backup_preview_text_primary" />
            <Button
                android:id="@+id/confirmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/settings_backup_preview_control_background"
                android:textColor="@color/settings_backup_preview_text_primary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
