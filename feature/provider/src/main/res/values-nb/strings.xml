    <string name="setup_epg_sync_mode_label">EPG-synk</string>
    <string name="setup_epg_sync_mode_helper">Umiddelbar beholder dagens oppførsel. Bakgrunn fullfører oppsettet først, og Hopp over lar guideoppdatering vente til senere.</string>
    <string name="setup_epg_sync_mode_upfront_title">Full EPG nå</string>
    <string name="setup_epg_sync_mode_upfront_description">Last ned leverandør- og ekstern guide-data under oppsettet før det er ferdig.</string>
    <string name="setup_epg_sync_mode_background_title">Last EPG i bakgrunnen</string>
    <string name="setup_epg_sync_mode_background_description">Fullfør oppsettet først, og hent deretter guide-data automatisk i bakgrunnen.</string>
    <string name="setup_epg_sync_mode_skip_title">Hopp over EPG for nå</string>
    <string name="setup_epg_sync_mode_skip_description">Ikke hent guide-data automatisk. Du kan oppdatere EPG senere fra Innstillinger.</string>
    <string name="setup_stalker_epg_sync_mode_helper">Stalker kan bruke portalens innebygde guide når XMLTV mangler eller ikke er tilgjengelig. Last inn nå importerer den under oppsettet, last inn i bakgrunnen utsetter det, og hopp over lar guideinnlasting skje ved behov.</string>
    <string name="setup_stalker_epg_sync_mode_upfront_description">Last ned direktekanaler og importer Stalker-portalens guide under oppsettet. Hvis XMLTV er konfigurert og fungerer, brukes det først.</string>
    <string name="setup_stalker_epg_sync_mode_background_description">Fullfør oppsettet først, og importer deretter Stalker-portalens guide i bakgrunnen. Hvis XMLTV er konfigurert og fungerer, brukes det først.</string>
    <string name="setup_stalker_epg_sync_mode_skip_description">Ikke importer guide-data i bulk automatisk. Data for direkteguiden kan fortsatt lastes ved behov mens du blar i kanaler.</string>
