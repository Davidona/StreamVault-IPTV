    <string name="setup_epg_sync_mode_upfront_description">Kurulum sırasında sağlayıcı ve harici rehber verilerini, kurulum bitmeden önce indir.</string>
    <string name="setup_epg_sync_mode_background_title">EPG’yi arka planda yükle</string>
